---
/**
 * The archive-style post list — a port of the row loop shared by archives.ejs,
 * tags.ejs and categories.ejs.
 *
 * Two variants, and they differ in more than a class:
 *   - "search" (the archive page): rows carry data-path so js/lib/search.js can
 *     tie a row back to its post. The wrapper is column-reverse, so the DOM
 *     order is oldest first and `--stagger-i` counts backwards from that.
 *   - "static" (a tag or category page): no search, newest first, the stagger
 *     counts forward.
 */
import { contentOf } from "../lib/content.js";

const { posts, variant = "static" } = Astro.props;
const isSearch = variant === "search";
const count = posts.length;
---

<div id="timeline-wrap" ref="timeline" class={isSearch ? undefined : "is-static"}>
    {
        posts.map((post, i) => {
            const stagger = isSearch ? Math.min(count - 1 - i, 18) : Math.min(i, 18);
            return (
                <div
                    class="timeline"
                    data-path={isSearch ? post.href : undefined}
                    data-outdated={post.outdated ? "true" : undefined}
                    style={`--stagger-i: ${stagger}`}
                >
                    <div class="timeline-tail" />
                    <div class="timeline-content">
                        <div class="item-time">{post.date.label}</div>
                        <a href={post.href}>
                            <h3>
                                {post.title}
                                {post.outdated && <span class="outdated-badge">Outdated</span>}
                            </h3>
                        </a>
                        <div class="info">
                            {post.category && (
                                <span class="category">
                                    <a href={post.category.href}>
                                        <span class="icon">
                                            <i class="fa-solid fa-bookmark fa-fw" />
                                        </span>
                                        {post.category.name}
                                    </a>
                                </span>
                            )}
                            {post.tags.length > 0 && (
                                <span class="tags">
                                    <span class="icon">
                                        <i class="fa-solid fa-tags fa-fw" />
                                    </span>
                                    {post.tags.map((tag) => (
                                        <span class="tag">
                                            <a
                                                href={tag.href}
                                                data-color-key={tag.name}
                                                data-color-prop="color"
                                            >
                                                {tag.name}
                                            </a>
                                        </span>
                                    ))}
                                </span>
                            )}
                        </div>
                    </div>
                </div>
            );
        })
    }
</div>
