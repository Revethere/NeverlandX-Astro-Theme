---
/** The archive timeline (all posts, oldest at the top) — a port of archives.ejs. */
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import { site, theme } from "../site.config.js";
import { getArchivePosts } from "../lib/content.js";

const posts = getArchivePosts();
---

<Base type="archives" title={`Archives | ${site.title}`}>
    <div id="archives">
        {
            theme.search.enable && (
                <input id="search-bar" class="input" placeholder="Search for..." />
            )
        }
        <Timeline posts={posts} variant="search" />
    </div>
</Base>
