---
/** All tags — a port of the tags/index.md page rendered by tags.ejs. */
import Base from "../../layouts/Base.astro";
import Chips from "../../components/Chips.astro";
import Timeline from "../../components/Timeline.astro";
import { site } from "../../site.config.js";
import { getPage, getTags } from "../../lib/content.js";

const page = getPage("tags");
const tags = getTags();
---

<Base type="tags" title={`${page.headTitle || page.title} | ${site.title}`}>
    <div id="archives">
        <Chips entries={tags} kind="tags" />
        <Timeline posts={[]} variant="static" />
    </div>
</Base>
